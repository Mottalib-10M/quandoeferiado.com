---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/${lang}/proximo-feriado/" title="Next public holiday in Brazil" width="100%" height="820" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Brazilian holiday calculator for free" description="Embed the next Brazilian holiday box for free with an iframe: it follows the reader’s state, counts the days left and updates itself when a new year starts." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the next-holiday box</h1>
    <p class="mt-3 text-lg text-navy-700">For unions, HR teams, schools and local newspapers: copy once, new years appear by themselves.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <h2>Next holiday</h2>
    <p>The next Brazilian holiday in the reader’s state, the days left and whether it makes a long weekend.</p>
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>For the Portuguese version, replace <code>/embed/en/</code> with <code>/embed/pt/</code>. Terms: the source link under the tool stays visible, the tool is not altered and is provided without warranty. What your readers enter stays on their device. Questions through the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src={`/embed/${lang}/proximo-feriado/`} title="Next public holiday in Brazil" width="100%" height="820" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
